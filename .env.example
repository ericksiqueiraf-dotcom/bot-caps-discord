# Copie para .env e preencha. NUNCA commitar o .env.
DISCORD_TOKEN=token-do-bot
RIOT_API_KEY=chave-da-riot-api

# Banco (MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGODB_DB=caps-bot

# Painel admin (Express)
ADMIN_PORT=3030

# Clube VIP (Mercado Pago) — opcional: sem token, pagamentos ficam desligados
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://seu-dominio
